# Run node scripts/setup.mjs to generate private local passwords in .env.
STORAGE_ADAPTER=postgres
# Local alternative: STORAGE_ADAPTER=sqlite, SQLITE_PATH=/absolute/path/ticketing.sqlite,
# and EMBEDDING_PROVIDER=none. No database server or model server is needed.
DB_PASSWORD=replace-with-generated-hex
APP_DB_PASSWORD=replace-with-generated-hex
KEYCLOAK_DB_PASSWORD=replace-with-generated-hex
KEYCLOAK_ADMIN_PASSWORD=replace-with-generated-hex
PUBLIC_URL=http://localhost:3000
OAUTH_ISSUER=http://localhost:8080/realms/ticketing
OAUTH_AUDIENCE=http://localhost:3000/mcp
OAUTH_JWKS_URL=http://keycloak:8080/realms/ticketing/protocol/openid-connect/certs
KEYCLOAK_PUBLIC_URL=http://localhost:8080
ALLOWED_ORIGIN_HOSTS=localhost
EMBEDDING_PROVIDER=ollama
EMBEDDING_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_REVISION=1
# Optional reference-token telemetry; context budget checks are always enabled.
REFERENCE_TOKEN_METRICS=false
# Development-default raw MCP capture contains ticket content and claim credentials.
# Set MCP_PROFILE_CAPTURE=false to opt out without creating capture files.
MCP_PROFILE_CAPTURE=true
MCP_PROFILE_DIRECTORY=.local/token-profiles
MCP_PROFILE_MAX_FILE_BYTES=8388608
MCP_PROFILE_MAX_FILES=8
MCP_PROFILE_MAX_QUEUE_BYTES=16777216
# Optional read-only GitHub evidence; all three trusted policy values are required.
# TICKETING_GITHUB_REPOSITORY=xRedLeader/ai-ticketing-mcp
# TICKETING_GITHUB_REQUIRED_CHECKS=verify
# TICKETING_GITHUB_CHECK_APP_ID=15368
# GITHUB_TOKEN belongs only in the private environment when authenticated reads are needed.
# Optional fixed outbound destination; configure both and use a private signing secret (32+ bytes).
# TICKETING_WEBHOOK_URL=https://receiver.example/hooks
# TICKETING_WEBHOOK_SECRET=
# Optional explicit identity only for endpoints serving the same embedding space.
EMBEDDING_SPACE_ID=local-ollama-nomic-v1
# Searches fall back to full text when query embeddings exceed this timeout.
EMBEDDING_QUERY_TIMEOUT_MS=2000
# The worker deletes idempotency receipts older than this; retries after it re-execute.
# RECEIPT_RETENTION_DAYS=30
# Full-text only: EMBEDDING_PROVIDER=none. Hosted alternative: EMBEDDING_PROVIDER=openai, URL=https://provider.example/v1,
# model and dimensions according to your provider, EMBEDDING_API_KEY in .env.
