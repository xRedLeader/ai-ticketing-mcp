# Run node scripts/setup.mjs to generate private local passwords in .env.
DB_PASSWORD=replace-with-generated-hex
APP_DB_PASSWORD=replace-with-generated-hex
KEYCLOAK_DB_PASSWORD=replace-with-generated-hex
KEYCLOAK_ADMIN_PASSWORD=replace-with-generated-hex
PUBLIC_URL=http://localhost:3000
OAUTH_ISSUER=http://localhost:8080/realms/ticketing
OAUTH_AUDIENCE=http://localhost:3000/mcp
OAUTH_JWKS_URL=http://keycloak:8080/realms/ticketing/protocol/openid-connect/certs
KEYCLOAK_PUBLIC_URL=http://localhost:8080
ALLOWED_ORIGIN_HOSTS=localhost
EMBEDDING_PROVIDER=ollama
EMBEDDING_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_REVISION=1
# Optional reference-token telemetry; context budget checks are always enabled.
REFERENCE_TOKEN_METRICS=false
# Optional explicit identity only for endpoints serving the same embedding space.
EMBEDDING_SPACE_ID=local-ollama-nomic-v1
# Hosted alternative: EMBEDDING_PROVIDER=openai, URL=https://provider.example/v1,
# model and dimensions according to your provider, EMBEDDING_API_KEY in .env.
